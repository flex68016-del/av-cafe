# Variables d'environnement pour Vercel
# Copiez ces variables dans les Environment Variables de votre projet Vercel

# Database URL Neon (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/av_cafe?sslmode=require

# Compte gérant - Remplacez par des valeurs réelles en production
MANAGER_EMAIL=manager@avenuecafe.tg
MANAGER_PASSWORD=CHANGEZ_CETTE_VALEUR_MOT_DE_PASSE_SECURISE

# Compte caissier - Remplacez par des valeurs réelles en production
CASHIER_EMAIL=cashier@avenuecafe.tg
CASHIER_PASSWORD=CHANGEZ_CETTE_VALEUR_MOT_DE_PASSE_SECURISE
